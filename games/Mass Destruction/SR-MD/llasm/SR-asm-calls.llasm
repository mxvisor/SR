include llasm.llinc

;; func, not funcv: funcv tells llasm the result is void, and `mov eax, tmp0`
;; after the call would read an unset tmp0 instead of the key state.
func Game_checkch
func Game_getch
func MD_vprintf *format, *ap
func MD_vsprintf *buf, *format, *ap
funcp Game_malloc size
funcv Game_free *ptr
funcp Game_fopen *filename, *mode
func Game_fclose *stream
func Game_fread *buffer, size, count, *stream
func Game_fwrite *buffer, size, count, *stream
func Game_fseek *stream, offset, whence
func Game_fgetc *stream
funcv Game_setbuf *stream, *buffer
func MD_vfprintf *stream, *format, *ap
func MD_vfscanf *stream, *format, *ap
func Game_open *path, oflag
func Game_read handle, *buffer, length
func Game_close handle
func Game_filelength handle
funcv Game_AIL_startup
funcv Game_AIL_shutdown
func Game_AIL_set_preference number, value
func Game_AIL_register_timer callback
funcv Game_AIL_set_timer_period timer, microseconds
funcv Game_AIL_start_timer timer
func Game_AIL_install_DIG_INI *dig
funcp Game_AIL_allocate_sample_handle *dig
funcv Game_AIL_init_sample *S
funcv Game_AIL_set_sample_address *S, *start, len
funcv Game_AIL_set_sample_type *S, format, flags
funcv Game_AIL_start_sample *S
funcv Game_AIL_stop_sample *S
funcv Game_AIL_end_sample *S
funcv Game_AIL_set_sample_playback_rate *S, playback_rate
funcv Game_AIL_set_sample_volume *S, volume
funcv Game_AIL_set_sample_loop_count *S, loop_count
func Game_AIL_sample_status *S

proc SR_checkch public
    call Game_checkch
    mov eax, tmp0
    load tmp0, esp, 4
    add esp, esp, 4
    tcall tmp0
endp

proc SR_getch public
    call Game_getch
    mov eax, tmp0
    load tmp0, esp, 4
    add esp, esp, 4
    tcall tmp0
endp

;; WATCOM printf, cdecl: the caller pops the arguments, so this pops only the
;; return address -- same shape as the trampolines above.
;;
;;   [esp + 2*4] = ...        (varargs)
;;   [esp +   4] = const char *format
;;   [esp      ] = return address
proc SR_printf public
    add tmp0, esp, 4
    load tmp0, tmp0, 4
    add tmp1, esp, 2*4
    call MD_vprintf tmp0, tmp1
    mov eax, tmp0
    load tmp0, esp, 4
    add esp, esp, 4
    tcall tmp0
endp

;; WATCOM sprintf, cdecl like printf above.
;;
;;   [esp + 3*4] = ...        (varargs)
;;   [esp + 2*4] = const char *format
;;   [esp +   4] = char *buf
;;   [esp      ] = return address
proc SR_sprintf public
    add tmp0, esp, 4
    load tmp0, tmp0, 4
    add tmp1, esp, 2*4
    load tmp1, tmp1, 4
    add tmp2, esp, 3*4
    call MD_vsprintf tmp0, tmp1, tmp2
    mov eax, tmp0
    load tmp0, esp, 4
    add esp, esp, 4
    tcall tmp0
endp
;; WATCOM _nmalloc/_nfree, register convention like kbhit/getch above: the
;; argument arrives in eax and every other register is preserved. _nfree
;; returns nothing, so eax is left as it is.
;;
;;   eax = size_t size / void *ptr
;;   [esp] = return address
proc SR__nmalloc public
    call Game_malloc eax
    mov eax, tmp0
    load tmp0, esp, 4
    add esp, esp, 4
    tcall tmp0
endp

proc SR__nfree public
    call Game_free eax
    load tmp0, esp, 4
    add esp, esp, 4
    tcall tmp0
endp

;; WATCOM file I/O (MD-proc-vfs.c). The register-convention ones are shaped
;; like _nmalloc above: arguments in eax, edx, ebx, ecx in that order, the
;; result in eax, every other register preserved. setbuf returns nothing.

;;   eax = const char *filename, edx = const char *mode
proc SR_fopen public
    call Game_fopen eax, edx
    mov eax, tmp0
    load tmp0, esp, 4
    add esp, esp, 4
    tcall tmp0
endp

;;   eax = FILE *stream
proc SR_fclose public
    call Game_fclose eax
    mov eax, tmp0
    load tmp0, esp, 4
    add esp, esp, 4
    tcall tmp0
endp

;;   eax = void *buffer, edx = size, ebx = count, ecx = FILE *stream
proc SR_fread public
    call Game_fread eax, edx, ebx, ecx
    mov eax, tmp0
    load tmp0, esp, 4
    add esp, esp, 4
    tcall tmp0
endp

;;   eax = const void *buffer, edx = size, ebx = count, ecx = FILE *stream
proc SR_fwrite public
    call Game_fwrite eax, edx, ebx, ecx
    mov eax, tmp0
    load tmp0, esp, 4
    add esp, esp, 4
    tcall tmp0
endp

;;   eax = FILE *stream, edx = offset, ebx = whence
proc SR_fseek public
    call Game_fseek eax, edx, ebx
    mov eax, tmp0
    load tmp0, esp, 4
    add esp, esp, 4
    tcall tmp0
endp

;;   eax = FILE *stream
proc SR_fgetc public
    call Game_fgetc eax
    mov eax, tmp0
    load tmp0, esp, 4
    add esp, esp, 4
    tcall tmp0
endp

;;   eax = FILE *stream, edx = char *buffer
proc SR_setbuf public
    call Game_setbuf eax, edx
    load tmp0, esp, 4
    add esp, esp, 4
    tcall tmp0
endp

;;   eax = int handle, edx = void *buffer, ebx = length
proc SR_read public
    call Game_read eax, edx, ebx
    mov eax, tmp0
    load tmp0, esp, 4
    add esp, esp, 4
    tcall tmp0
endp

;;   eax = int handle
proc SR_close public
    call Game_close eax
    mov eax, tmp0
    load tmp0, esp, 4
    add esp, esp, 4
    tcall tmp0
endp

;;   eax = int handle
proc SR_filelength public
    call Game_filelength eax
    mov eax, tmp0
    load tmp0, esp, 4
    add esp, esp, 4
    tcall tmp0
endp

;; fprintf and fscanf are cdecl like printf/sprintf above.
;;
;;   [esp + 3*4] = ...        (varargs)
;;   [esp + 2*4] = const char *format
;;   [esp +   4] = FILE *stream
;;   [esp      ] = return address
proc SR_fprintf public
    add tmp0, esp, 4
    load tmp0, tmp0, 4
    add tmp1, esp, 2*4
    load tmp1, tmp1, 4
    add tmp2, esp, 3*4
    call MD_vfprintf tmp0, tmp1, tmp2
    mov eax, tmp0
    load tmp0, esp, 4
    add esp, esp, 4
    tcall tmp0
endp

proc SR_fscanf public
    add tmp0, esp, 4
    load tmp0, tmp0, 4
    add tmp1, esp, 2*4
    load tmp1, tmp1, 4
    add tmp2, esp, 3*4
    call MD_vfscanf tmp0, tmp1, tmp2
    mov eax, tmp0
    load tmp0, esp, 4
    add esp, esp, 4
    tcall tmp0
endp

;; WATCOM open is cdecl too; the optional permission argument is not needed.
;;
;;   [esp + 2*4] = int oflag
;;   [esp +   4] = const char *path
;;   [esp      ] = return address
proc SR_open public
    add tmp0, esp, 4
    load tmp0, tmp0, 4
    add tmp1, esp, 2*4
    load tmp1, tmp1, 4
    call Game_open tmp0, tmp1
    mov eax, tmp0
    load tmp0, esp, 4
    add esp, esp, 4
    tcall tmp0
endp

;; Miles AIL 3.x (MD-sound.c), cdecl: arguments on the stack from [esp + 4],
;; the caller pops them, the result in eax.  AIL's own wrappers preserve ebx,
;; esi, edi and ebp; these leave every register but eax untouched.

proc SR_AIL_startup public
    call Game_AIL_startup
    load tmp0, esp, 4
    add esp, esp, 4
    tcall tmp0
endp

proc SR_AIL_shutdown public
    call Game_AIL_shutdown
    load tmp0, esp, 4
    add esp, esp, 4
    tcall tmp0
endp

proc SR_AIL_set_preference public
    add tmp0, esp, 4
    load tmp0, tmp0, 4
    add tmp1, esp, 2*4
    load tmp1, tmp1, 4
    call Game_AIL_set_preference tmp0, tmp1
    mov eax, tmp0
    load tmp0, esp, 4
    add esp, esp, 4
    tcall tmp0
endp

